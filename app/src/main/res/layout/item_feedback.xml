<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginBottom="12dp"
    app:cardElevation="6dp"
    app:cardCornerRadius="16dp"
    android:backgroundTint="@android:color/white">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Teacher name aligned to top-end -->
        <TextView
            android:id="@+id/teacherEmailText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="By: teacher"
            android:textColor="#3949AB"
            android:textSize="12sp"
            android:textStyle="italic"
            tools:text="By: Prof. Abhishek Patil" />

        <!-- Topic -->
        <TextView
            android:id="@+id/topicText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/teacherEmailText"
            android:layout_marginTop="4dp"
            android:text="Topic"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1A237E"
            tools:text="Punctuality" />

        <!-- Description -->
        <TextView
            android:id="@+id/descriptionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/topicText"
            android:layout_marginTop="6dp"
            android:text="Description of feedback goes here..."
            android:textSize="14sp"
            android:textColor="#424242"
            tools:text="Student should improve their punctuality for practical sessions." />
    </RelativeLayout>
</androidx.cardview.widget.CardView>
